{
	"version": "0.2.0",
	"configurations": [
		{
			// Attach to the instance ./start.sh is running. Build it with ./debug-build.sh first.
			"name": "Attach to lab (start.sh)",
			"type": "go",
			"request": "attach",
			"mode": "local",
			"processId": "${command:pickGoProcess}"
		},
		{
			// Or start the instance under the debugger, like start.sh (stop start.sh first: same port).
			"name": "Run lab under debugger",
			"type": "go",
			"request": "launch",
			"mode": "exec",
			"program": "${workspaceFolder}/bin/pocketone",
			"args": ["serve", "--dir", "pb_data", "--http", "127.0.0.1:8090"],
			"cwd": "${workspaceFolder}"
		}
	]
}
