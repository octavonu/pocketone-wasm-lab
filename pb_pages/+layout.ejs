<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%- slot('title') || 'WASM lab' %></title>
  <style>
    :root {
      --bg: #fafaf9; --fg: #1c1917; --muted: #78716c; --line: #e7e5e4; --card: #fff;
      --accent: #2563eb; --ok: #15803d; --warn: #b45309; --bad: #b91c1c;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #1c1917; --fg: #f5f5f4; --muted: #a8a29e; --line: #44403c; --card: #292524;
        --accent: #60a5fa; --ok: #4ade80; --warn: #fbbf24; --bad: #f87171;
      }
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: var(--fg); font: 15px/1.5 system-ui, sans-serif; }
    main { max-width: 860px; margin: 0 auto; padding: 24px 16px 64px; }
    header { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 16px; }
    h1 { font-size: 22px; margin: 0; }
    h2 { font-size: 17px; margin: 0; }
    a { color: var(--accent); }
    code { font-size: 13px; }
    pre { margin: 0; white-space: pre-wrap; word-break: break-all; }
    th { white-space: nowrap; vertical-align: top; }
    h3 { font-size: 15px; margin: 16px 0 4px; }
    details.example { border-top: 1px solid var(--line); padding: 6px 0; }
    details.example summary { cursor: pointer; font-weight: 600; font-size: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    details.example summary .muted { font-weight: 400; font-family: ui-monospace, monospace; }
    .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 16px; margin: 12px 0; }
    .row { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; }
    .muted { color: var(--muted); font-size: 13px; }
    .badge { display: inline-block; padding: 1px 8px; border-radius: 99px; font-size: 12px; border: 1px solid currentColor; }
    .on { color: var(--ok); } .err { color: var(--bad); } .off { color: var(--muted); }
    .flash { padding: 10px 14px; border-radius: 8px; border: 1px solid var(--line); background: var(--card); }
    .flash.error { border-color: var(--bad); color: var(--bad); }
    table { width: 100%; border-collapse: collapse; margin: 10px 0; }
    td, th { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--line); font-size: 14px; }
    th { font-weight: 600; color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .03em; }
    .danger-note { color: var(--warn); font-size: 13px; }
    input[type=text], input[type=email], input[type=password], input[type=file] {
      font: inherit; color: inherit; background: var(--bg); border: 1px solid var(--line); border-radius: 6px;
      padding: 6px 8px; max-width: 100%;
    }
    button { font: inherit; padding: 6px 12px; border-radius: 6px; border: 1px solid var(--line); background: var(--bg); color: var(--fg); cursor: pointer; }
    button.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
    button.danger { color: var(--bad); }
    form.inline { display: inline; }
    label.field { display: grid; gap: 4px; margin-bottom: 10px; }
  </style>
</head>
<body><main><%- slot() %></main></body>
</html>
