<% slot('title', () => { %>Sign in<% }) %>
<% const flash = ctx.flash() %>
<header><h1>Sign in</h1></header>
<% if (flash && flash.error) { %><p class="flash error"><%= flash.error %></p><% } %>
<form method="post" class="card">
  <p class="muted">The WASM modules in pb_hooks/ can be managed by superusers only.</p>
  <label class="field">Email <input type="email" name="email" required autofocus></label>
  <label class="field">Password <input type="password" name="password" required></label>
  <button class="primary">Sign in</button>
</form>
